{
  "name": "glypho-ocr",
  "version": "0.2.1",
  "description": "Fast multilingual OCR for Node.js with a persistent native runtime",
  "keywords": [
    "ocr",
    "onnx",
    "computer-vision",
    "text-recognition",
    "image-to-text",
    "multilingual",
    "typescript"
  ],
  "license": "Apache-2.0",
  "homepage": "https://glypho.rinqaku.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinqaku/Glypho.git",
    "directory": "js"
  },
  "bugs": "https://github.com/rinqaku/Glypho/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "glypho": "src/cli.js"
  },
  "optionalDependencies": {
    "glypho-ocr-darwin-arm64": "0.2.1",
    "glypho-ocr-linux-arm64": "0.2.1",
    "glypho-ocr-linux-x64": "0.2.1",
    "@rinqaku/glypho-ocr-win32-arm64": "0.2.1",
    "@rinqaku/glypho-ocr-win32-x64": "0.2.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node test/glypho.test.js"
  }
}
